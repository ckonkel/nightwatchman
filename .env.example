# Container images
GLUETUN_IMAGE=qmcgaw/gluetun:latest
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:latest

# VPN connection
VPN_SERVICE_PROVIDER=your-provider
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_REGIONS=your-region

# Published application ports
WEBUI_PORT=8080
TORRENTING_PORT=6881

# qBittorrent process identity and timezone
PUID=1000
PGID=1000
TZ=Etc/UTC

# Absolute host directory placeholders
CONFIG_PATH=/path/to/qbittorrent/config
DOWNLOADS_PATH=/path/to/downloads
